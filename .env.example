# ─── Kommo CRM (API v4) ───────────────────────────────────────────────
# Subdomínio da conta: https://comercialblueclinica.kommo.com
KOMMO_SUBDOMAIN=comercialblueclinica
# Token de longa duração (Configurações > Integrações > sua integração privada > Chaves e escopos)
KOMMO_TOKEN=cole_aqui_o_bearer_token_de_longa_duracao

# Rate limit: o Kommo aceita até 7 req/s. Usamos 4 req/s (1 chamada a cada 250 ms).
KOMMO_MIN_INTERVAL_MS=250
KOMMO_MAX_CONCURRENCY=4
KOMMO_MAX_RETRIES=5
KOMMO_TIMEOUT_MS=30000

# Conta comercialblueclinica: funil "Comercial 1" (13604187).
# NOVOS = "Qualificação Bot" · QUALIFICADOS = "Qualificado" · APN = "Agendamento Confirmado" · Score = campo "Score".
# Funil principal (opcional). Vazio = funil principal da conta.
KOMMO_PIPELINE_ID=13604187
# IDs das etapas usadas pela Alice. Vazio = detectado pelo nome ("Qualificados" / "Novos").
KOMMO_STATUS_QUALIFICADOS_ID=104983959
KOMMO_STATUS_NOVOS_ID=104983955
# Etapas que contam como APN (agendamento). Lista separada por vírgula. Vazio = etapas com "agend" ou "consulta" no nome.
KOMMO_APN_STATUS_IDS=104983967
# Campo personalizado (numérico) do lead onde o score será gravado (opcional).
KOMMO_SCORE_FIELD_ID=3837342
# Campos preenchidos pela Alice/retroativo (conta comercialblueclinica)
KOMMO_CLASSIFICACAO_FIELD_ID=3837344
KOMMO_CLASSIFICACAO_ENUMS={"fria":735973966,"morna":735973968,"quente":735973972}
KOMMO_OBJECAO_FIELD_ID=3837346
KOMMO_OBJECAO_ENUMS={"valor_consulta":735973946,"valor_cirurgia":735973946,"forma_pagamento":735973946,"plano_saude":735973946,"medo_cirurgia":735973948,"resultado_artificial":735973948,"pele_irregular":735973948,"distancia":735973950,"internacional":735973950,"consulta_online":735973950,"tempo_afastamento":735973952,"sem_tempo":735973952,"decisao_compartilhada":735973954,"comparacao_medicos":735973958,"recuperacao_dificil":735973960,"promessas_exageradas":735973962}
KOMMO_RESUMO_FIELD_ID=3839836
KOMMO_PAGAMENTO_FIELD_ID=3728960
KOMMO_CONSULTA_FIELD_ID=3728948
KOMMO_CONSULTA_EVENTOS_DESDE=2026-09-24
# Etapa de handoff (leads quentes → Maria). Vazio = detecta "Interesse em agendar" pelo nome.
KOMMO_STATUS_INTERESSE_ID=106593295
# Campo personalizado de faixa de renda (card "Leads com renda" do painel). Vazio = "—".
KOMMO_RENDA_FIELD_ID=
# Venda com valor >= este (ou tag/nome com cirurgia/LipeDefinition/Sublift) conta como Cirurgia (CM2); abaixo, Consulta (CM1).
KOMMO_CIRURGIA_MIN_PRICE=10000
# Funis do painel e como aparecem na tabela do time (um funil por comercial).
KOMMO_METRICS_PIPELINES={"13604187":{"name":"Maria","role":"Comercial 1"},"13687203":{"name":"Mayra","role":"Comercial 2"}}
# Cargo exibido no painel por usuário do Kommo (id → texto).
KOMMO_TEAM_ROLES_JSON={"123456":"C01B · Closer Lya","234567":"C01A · Closer Sarah"}
# Investimento em ADS por mês (não existe no Kommo). Usado nos cards ADS e CAC.
ADS_INVESTIMENTO_JSON={"2026-09":15034.66,"2026-08":13880}

# ─── Servidor ─────────────────────────────────────────────────────────
PORT=3000
# Origens liberadas no CORS (vírgula). "*" libera todas.
CORS_ORIGINS=*
# Segredo exigido nos webhooks: configure a URL como .../api/webhooks/kommo?token=SEGREDO
WEBHOOK_SECRET=troque_este_segredo
# Cache do /api/metrics em segundos
METRICS_CACHE_SECONDS=60
# Quantos meses (incluindo o atual) o /api/metrics devolve
METRICS_MONTHS=3
TZ=America/Sao_Paulo

# ─── Supabase (espelho do CRM) ────────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
